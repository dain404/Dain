# EditorConfig - chuẩn hóa encoding và format cho toàn bộ project
# Xem thêm: https://editorconfig.org

root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.java]
indent_size = 4

[*.html]
indent_size = 4

[*.xml]
indent_size = 4

[*.properties]
charset = utf-8

[*.sql]
charset = utf-8

[*.css]
indent_size = 4

[*.js]
indent_size = 4

[Makefile]
indent_style = tab
